{
  "name": "salesforce-playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:readonly": "playwright test --grep-invert @writes",
    "cleanup": "cross-env CLEANUP=0 playwright test -c playwright.cleanup.config.ts",
    "cleanup:delete": "cross-env CLEANUP=1 playwright test -c playwright.cleanup.config.ts",
    "auth": "tsx save-auth.ts",
    "records": "tsx scripts/list-records.ts",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-playwright": "^2.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
