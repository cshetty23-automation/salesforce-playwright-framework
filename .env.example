# Copy to .env and fill in. .env is gitignored — a fresh clone never has one.

# Base URL of the org under test. Wired into both Playwright configs as `use.baseURL`,
# so specs navigate with root-relative paths and this is the only place the org appears.
# Point the suite at a different org by changing this line.
SF_LOGIN_URL=https://your-org.develop.lightning.force.com

# Used only by save-auth.ts to refresh playwright/.auth/user.json.
# Specs never log in; they run off the saved storage state.
SF_USERNAME=you@example.com
SF_PASSWORD=your-password
