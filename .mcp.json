{
  "mcpServers": {
    "playwright-test": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "playwright",
        "run-test-mcp-server",
        "-c",
        "playwright.agents.config.ts"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--storage-state=playwright/.auth/user.json"
      ]
    }
  }
}
